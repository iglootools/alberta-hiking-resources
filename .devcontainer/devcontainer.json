{
  // A full Linux environment for the project, usable from GitHub Codespaces or
  // the VS Code Dev Containers extension against local Docker. CodeSandbox is not
  // one of them: it retired repository import
  // (docs/setup-development-environment.md, "Why CodeSandbox is not listed").
  //
  // This exists alongside .stackblitzrc, which is not an alternative to it:
  // StackBlitz runs Node compiled to WebAssembly inside a browser tab, so there
  // is no container for a devcontainer.json to describe and no way to load the
  // project's native addons, and it cannot run this project at all
  // (docs/setup-development-environment.md, "StackBlitz (does not currently
  // work)"). This is where `mise run ci-preflight` -- lints, tests, build --
  // actually runs.
  "name": "Alberta Hiking Resources",

  // A plain Ubuntu base rather than a Node image, because mise installs Node and
  // pnpm from mise.lock. See the rationale in setup.sh.
  //
  // 26.04, the current LTS. Note the tag spelling: Microsoft publishes the
  // dashed form (`ubuntu-24.04`) only up to 24.04, so this one has no dash.
  //
  // This deliberately runs ahead of CI, where `ubuntu-latest` still resolves to
  // ubuntu-24.04 (see the "Runner Image" line in any CI job's setup step). The
  // divergence is narrow: the base image contributes little beyond glibc, curl,
  // and the C++ toolchain that compiles better-sqlite3 from source, and that
  // binary never leaves the container. Everything that determines what the app
  // actually runs on -- Node, pnpm -- comes from mise.lock and is identical in
  // both. The gap closes on its own when GitHub moves `ubuntu-latest` to 26.04.
  //
  // If a native module ever builds here but fails in CI, this is the first place
  // to look, and pinning back to `ubuntu-24.04` is the fix.
  //
  // Pinned by digest so the base changes only through a reviewed diff; Renovate's
  // devcontainer manager moves the digest with the tag.
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu26.04@sha256:e15941f70f26542ef9b0ef4bb64f88b8ecdfe8c3372e730ab6e405792805e742",

  // onCreateCommand rather than postCreateCommand so that Codespaces prebuilds
  // bake the apt packages, the toolchain, and node_modules into the image. Left
  // as a postCreateCommand it would re-run on every codespace start.
  "onCreateCommand": "bash .devcontainer/setup.sh",

  "forwardPorts": [3000],

  "portsAttributes": {
    "3000": {
      "label": "Nuxt dev server",
      "onAutoForward": "openPreview"
    }
  },

  "customizations": {
    "vscode": {
      // Mirrors .vscode/extensions.json: keep the two lists in step. A
      // container installs these rather than prompting for the
      // recommendations, and .vscode/settings.json names dprint.dprint and
      // rvben.rumdl as formatters, so without them format-on-save silently
      // does nothing here.
      "extensions": [
        "nuxt.mdc",
        "Vue.volar",
        "dbaeumer.vscode-eslint",
        "hverlin.mise-vscode",
        "dprint.dprint",
        "rvben.rumdl",
        "tombi-toml.tombi"
      ]
    }
  }
}
