# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist

# Node dependencies
node_modules

# Local pnpm content-addressable store. Not the store this project uses -- pnpm
# resolves to the global one (`pnpm store path`) -- but sandbox environments with
# a different HOME (devcontainer, StackBlitz) drop one here, and its SQLite
# index plus -shm/-wal files are per-machine state that must never be committed.
.pnpm-store

# Logs
logs
*.log

# Misc
.DS_Store
.fleet
.idea

# Local env files
.env
.env.*
!.env.example

# VSC
.history

# Per-machine symlinks to mise-managed tool binaries, generated by hverlin.mise-vscode
# when mise.configureExtensionsUseSymLinks is on. They point into ~/.local/share/mise,
# so they are valid only on the machine that created them. Ignoring them is a condition
# of sharing .vscode/settings.json, which references them by path.
.vscode/mise-tools/

# Worksheet written by `mise run build-trip-index`: the objectives it could not
# place, the regions its sources disagreed on, and near-miss names that may be
# duplicates. Regenerated every run and meant to be worked through, not kept --
# the decisions it leads to live in scripts/trip-report-index/curation.ts.
/trip-report-review.md

# Generated output of the iglootools plugin and tools, such as audit reports under
# .iglootools/audits/. Never committed: see the .gitignore rule in
# https://github.com/iglootools/common/blob/main/guidelines/project-setup/repository.md
.iglootools/

# The environment uv builds for the iglootools commands (pyproject.toml).
.venv/
