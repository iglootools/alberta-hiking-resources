# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist

# Node dependencies
node_modules

# Local pnpm content-addressable store. Not the store this project uses -- pnpm
# resolves to the global one (`pnpm store path`) -- but sandbox environments with
# a different HOME (devcontainer, StackBlitz) drop one here, and its SQLite
# index plus -shm/-wal files are per-machine state that must never be committed.
.pnpm-store

# Logs
logs
*.log

# Misc
.DS_Store
.fleet
.idea

# Local env files
.env
.env.*
!.env.example

# VSC
.history

# Per-machine symlinks to mise-managed tool binaries, generated by hverlin.mise-vscode
# when mise.configureExtensionsUseSymLinks is on. They point into ~/.local/share/mise,
# so they are valid only on the machine that created them. Ignoring them is a condition
# of sharing .vscode/settings.json, which references them by path.
.vscode/mise-tools/
